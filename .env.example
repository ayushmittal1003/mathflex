# ---- Database (local: `npm run db:start` spins up Postgres on 51214) ----
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ---- Auth ----
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

# ---- Public site URL (used for payment callbacks) ----
APP_URL="http://localhost:3000"

# ---- FlexCare chatbot (Claude). Leave empty to run the chatbot in offline FAQ mode ----
ANTHROPIC_API_KEY=""

# ---- Cashfree Payment Gateway (server only; never expose the secret) ----
# Leave empty locally to use the built-in test checkout instead.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox" # sandbox | production

# ---- Bunny Stream (video hosting) ----
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME=""
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME="" # pull-zone hostname, e.g. vz-xxxx.b-cdn.net; used for video thumbnails
# ALLOW_MOCK_PAYMENTS="1"  # only to allow the test-payment screen in production without Cashfree

# "Continue with Google" (optional). Google Cloud Console → Credentials → OAuth client (Web).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Student app on its own address (leave all four blank to keep everything on one domain) ---
# APP_HOST=app.mathflex.in
# SITE_HOST=mathflex.in
# COOKIE_DOMAIN=.mathflex.in
# NEXT_PUBLIC_COOKIE_DOMAIN=.mathflex.in

# Sanity CMS (blog). Project ID and dataset are public identifiers; the two secrets are not.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-24"
# Viewer token, only needed for draft previews. Server-side only.
SANITY_API_READ_TOKEN=""
# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=""

# Meta Lead Ads → Admin → Leads (webhook at https://www.mathflex.in/api/meta/leads)
META_LEADS_VERIFY_TOKEN=""   # any secret phrase; type the same into Meta's "Verify token" box
META_APP_SECRET=""           # Meta app → Settings → Basic → App secret
META_PAGE_TOKEN=""           # long-lived Page access token with leads_retrieval

# Instant new-lead alerts on Telegram (free). Bot from @BotFather; chat ids comma-separated.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
