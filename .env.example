# ---- Database (local: `npm run db:start` spins up Postgres on 51214) ----
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ---- Auth ----
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

# ---- Public site URL (used for payment callbacks) ----
APP_URL="http://localhost:3000"

# ---- FlexCare chatbot (Claude). Leave empty to run the chatbot in offline FAQ mode ----
ANTHROPIC_API_KEY=""

# ---- Cashfree Payment Gateway (server only; never expose the secret) ----
# Leave empty locally to use the built-in test checkout instead.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox" # sandbox | production

# ---- Bunny Stream (video hosting) ----
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME=""
# ALLOW_MOCK_PAYMENTS="1"  # only to allow the test-payment screen in production without Cashfree

# "Continue with Google" (optional). Google Cloud Console → Credentials → OAuth client (Web).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
