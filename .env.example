# ---- Database (local: `npm run db:start` spins up Postgres on 51214) ----
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ---- Auth ----
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

# ---- Public site URL (used for payment callbacks) ----
APP_URL="http://localhost:3000"

# ---- FlexCare chatbot (Claude). Leave empty to run the chatbot in offline FAQ mode ----
ANTHROPIC_API_KEY=""

# ---- Paytm (leave empty to use MOCK payments in development) ----
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
PAYTM_WEBSITE="WEBSTAGING"
PAYTM_ENV="staging" # staging | production

# ---- Bunny Stream (video hosting) ----
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME=""
# PAYTM_HOST=""            # override if Paytm gives you a different gateway domain
# ALLOW_MOCK_PAYMENTS="1"  # only to allow the test-payment screen in production
